{
  "name": "pokomatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && pnpm run build:client && pnpm run build:server && pnpm run prerender",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "tsx scripts/prerender.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:core": "vitest run --config vitest.core.config.ts --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "preview": "vite preview",
    "refresh-dex": "tsx ./scripts/pokemon-data-collector.ts",
    "refresh-sprites": "tsx ./scripts/pokemon-sprite-collector.ts",
    "refresh-items": "tsx ./scripts/item-data-collector.ts && pnpm run validate-items",
    "validate-items": "tsx ./scripts/validate-items.ts",
    "refresh-all": "tsx ./scripts/refresh-all.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "html-to-image": "^1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
