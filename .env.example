# Create a free access key at https://web3forms.com
# Then enable hCaptcha under the form's spam settings in the Web3Forms dashboard.
VITE_WEB3FORMS_ACCESS_KEY=

# Web3Forms free-plan hCaptcha site key (or your own if on a paid plan):
# https://docs.web3forms.com/getting-started/customizations/spam-protection/hcaptcha
VITE_HCAPTCHA_SITEKEY=
